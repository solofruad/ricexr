<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/RiceXR/UI/SessionIntro/SessionIntro.uss"/>
    <ui:VisualElement name="intro-steps" class="panel">
        <ui:VisualElement class="dots">
            <ui:VisualElement class="dot"/>
            <ui:VisualElement class="dot"/>
            <ui:VisualElement class="dot dot--active"/>
            <ui:VisualElement class="dot"/>
        </ui:VisualElement>

        <ui:Label text="Tu trabajo, en tres pasos" class="title reveal"/>

        <ui:VisualElement class="hero">
            <ui:VisualElement class="steps hero__text">
                <ui:VisualElement class="step step--first reveal">
                    <ui:Label text="1" class="step__index"/>
                    <ui:VisualElement class="step__body">
                        <ui:Label text="Observa" class="step__name"/>
                        <ui:Label text="Toma una hoja y mírala de cerca." class="step__detail"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="step reveal">
                    <ui:Label text="2" class="step__index"/>
                    <ui:VisualElement class="step__body">
                        <ui:Label text="Identifica" class="step__name"/>
                        <ui:Label text="Elige la enfermedad y su gravedad, del 1 al 5." class="step__detail"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="step reveal">
                    <ui:Label text="3" class="step__index"/>
                    <ui:VisualElement class="step__body">
                        <ui:Label text="Aprende" class="step__name"/>
                        <ui:Label text="Descubre cómo se llama, cómo se ve y cómo se combate." class="step__detail"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Image class="hero__image reveal" style="background-image: url(&quot;project://database/Assets/RiceXR/UI/Images/HandHoldingEye.png?fileID=2800000&amp;guid=45c9c0d05c12d3143a7f2242a7113002&amp;type=3#HandHoldingEye&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
