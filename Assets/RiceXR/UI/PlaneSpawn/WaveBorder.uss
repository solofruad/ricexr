/* ============================================================
   WaveBorder.uss — indicador animado de selección de plano.
   La barra y las ondas siguen siendo controladas por C#.
   ============================================================ */

.main-container {
    width: 400px;
    height: 400px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.loading-bar {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
}

.wave-line {
    position: absolute;
    width: 100%;
    height: 100%;
}

.content-box {
    align-items: center;
    justify-content: center;
}
