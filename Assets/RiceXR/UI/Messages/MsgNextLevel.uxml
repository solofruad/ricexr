<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/RiceXR/UI/Shared/RiceXRUI.uss"/>
    <ui:VisualElement name="msg-next-level" class="quest-surface quest-surface--compact quest-panel quest-panel--centered quest-message">
        <ui:Label text="⬆" class="quest-message__icon quest-accent--blue" style="margin-bottom: 10px;"/>

        <ui:Label name="nextlevel-title" text="Siguiente Nivel" class="quest-message__title"/>
        <ui:Label name="nextlevel-sub" text="Prepárate. La dificultad aumenta." class="quest-message__subtitle"/>

        <ui:VisualElement class="quest-message__rule quest-message__rule--blue"/>
    </ui:VisualElement>
</ui:UXML>
