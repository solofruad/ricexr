<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/RiceXR/UI/Shared/RiceXRUI.uss?fileID=7433441132597879392&amp;guid=aa710d7cc42d420895fc62535ed1a2c5&amp;type=3#RiceXRUI"/>
    <Style src="project://database/Assets/RiceXR/UI/DiseaseIntro/DiseaseIntro.uss?fileID=7433441132597879392&amp;guid=382e58b009ca23740a9e2e8b5f4c6893&amp;type=3#DiseaseIntro"/>
    <ui:VisualElement name="message-panel" class="disease-intro">
        <ui:VisualElement class="disease-intro__dots">
            <ui:VisualElement class="disease-intro__dot disease-intro__dot--active"/>
            <ui:VisualElement class="disease-intro__dot"/>
            <ui:VisualElement class="disease-intro__dot"/>
        </ui:VisualElement>
        <ui:VisualElement class="disease-intro__split">
            <ui:VisualElement class="disease-intro__col">
                <ui:Label name="disease-intro-category" text="Enfermedad fúngica" class="disease-intro__eyebrow reveal" style="color: rgb(255, 255, 255);"/>
                <ui:Label name="message-title" text="Añublo del arroz" class="disease-intro__title reveal"/>
                <ui:Label name="disease-intro-scientific" text="Pyricularia oryzae" class="disease-intro__scientific reveal"/>
                <ui:VisualElement class="disease-intro__rule reveal"/>
                <ui:Label name="message-body" text="La enfermedad más destructiva del arroz en el mundo. Vas a aprender a reconocerla." class="disease-intro__body reveal"/>
            </ui:VisualElement>
            <ui:Image name="disease-intro-image" scale-mode="ScaleAndCrop" class="disease-intro__hero reveal"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
