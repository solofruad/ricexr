<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- ============================================================
         Panel 2 de 3 — LA ENFERMEDAD

         Que es y como se reconoce, pensado para leerse de un vistazo:
         una frase breve arriba y tres tarjetas en columna debajo.

         Las tres tarjetas son lo que hay que llevarse en la cabeza
         —agente causal, como se propaga, que buscar en la hoja— para
         que el jugador llegue a las hojas sabiendo QUE mirar.

         Lo llena DiseaseIntroStepPanel:
           message-title           ← infoHeadline
           message-body            ← infoBody (o data.description si falta)
           disease-intro-row-0..2  ← infoRows (tarjetas; las vacias se ocultan)
           disease-intro-image     ← infoImage

         El orden de los elementos con clase 'reveal' es el orden en
         que entran.
         ============================================================ -->
    <Style src="project://database/Assets/RiceXR/UI/Shared/RiceXRUI.uss" />
    <Style src="project://database/Assets/RiceXR/UI/DiseaseIntro/DiseaseIntro.uss" />

    <ui:VisualElement name="message-panel" class="disease-intro">

        <ui:VisualElement class="disease-intro__dots">
            <ui:VisualElement class="disease-intro__dot" />
            <ui:VisualElement class="disease-intro__dot disease-intro__dot--active" />
            <ui:VisualElement class="disease-intro__dot" />
        </ui:VisualElement>

        <ui:VisualElement class="disease-intro__header">
            <ui:VisualElement class="disease-intro__col">
                <ui:Label name="message-title" text="¿Qué es esta enfermedad?"
                          class="disease-intro__title reveal" />
                <ui:Label name="message-body"
                          text="Un hongo que mancha las hojas y puede dañar el grano."
                          class="disease-intro__body reveal" />
            </ui:VisualElement>

            <ui:Image name="disease-intro-image" scale-mode="ScaleAndCrop"
                      class="disease-intro__image reveal" />
        </ui:VisualElement>

        <ui:VisualElement class="disease-intro__cards">

            <ui:VisualElement name="disease-intro-row-0" class="disease-intro__card reveal">
                <ui:VisualElement class="disease-intro__card-accent" />
                <ui:Label text="Causa" class="disease-intro__row-title" />
                <ui:Label text="Un hongo."
                          class="disease-intro__row-detail" />
            </ui:VisualElement>

            <ui:VisualElement name="disease-intro-row-1" class="disease-intro__card reveal">
                <ui:VisualElement class="disease-intro__card-accent" />
                <ui:Label text="Propagación" class="disease-intro__row-title" />
                <ui:Label text="Esporas en el viento y el rocío."
                          class="disease-intro__row-detail" />
            </ui:VisualElement>

            <ui:VisualElement name="disease-intro-row-2" class="disease-intro__card reveal">
                <ui:VisualElement class="disease-intro__card-accent" />
                <ui:Label text="Qué observar" class="disease-intro__row-title" />
                <ui:Label text="Manchas alargadas con borde marrón."
                          class="disease-intro__row-detail" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
