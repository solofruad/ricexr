<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/RiceXR/UI/Shared/RiceXRUI.uss"/>
    <ui:VisualElement name="msg-tutorial-start" class="quest-surface quest-surface--compact quest-panel quest-panel--centered quest-message quest-message--tutorial">
        <ui:VisualElement class="quest-icon-disc" style="margin-bottom: 12px;">
            <ui:Label text="1" class="quest-icon-disc__label"/>
        </ui:VisualElement>

        <ui:Label name="tutorialstart-title" text="Inicia el Nivel 1: Tutorial" class="quest-message__title" style="margin-bottom: 6px;"/>

        <ui:Label name="tutorialstart-sub" text="Primero aprenderas a usar la herramienta VR." class="quest-message__subtitle" style="max-width: 420px; margin-bottom: 10px;"/>

        <ui:VisualElement class="quest-card" style="width: 420px; padding: 8px 12px; align-items: center;">
            <ui:Label text="Objetivo inicial: completar 2 hojas guiadas en el tutorial." class="quest-caption" style="-unity-text-align: middle-center;"/>
        </ui:VisualElement>

        <ui:VisualElement class="quest-rule quest-accent--blue" style="margin-top: 14px;"/>
    </ui:VisualElement>
</ui:UXML>
