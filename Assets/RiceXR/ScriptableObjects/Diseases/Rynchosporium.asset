  m_Name: Rynchosporium
  m_EditorClassIdentifier: Assembly-CSharp::PanelDiseaseDataObject
  id: rhynchosporium-oryzae
  data:
    title: Escaldado del arroz
    scientificName: Rhynchosporium oryzae
    category: "Enfermedad F\xFAngica"
    description: "El s\xEDntoma inconfundible de esta enfermedad es que ataca directamente
      las puntas de las hojas. La infecci\xF3n comienza en el \xE1pice y avanza hacia
      la base, creando un patr\xF3n de bandas conc\xE9ntricas (como los anillos de
      un tronco) en tonos paja y marr\xF3n. Visualmente, parece que la hoja hubiera
      sido sumergida en agua hirviendo, sec\xE1ndose desde la punta hacia abajo en
      franjas onduladas."
    severityEvolutionImage: {fileID: 0}
    images:
    - {fileID: 2800000, guid: a4e691c882bab5a46afeebf361b746f9, type: 3}
    - {fileID: 2800000, guid: ab28e94ca4c149b4480002ffe8eff867, type: 3}
    - {fileID: 2800000, guid: d3b4ba71e9475d24b863b036d8ec896d, type: 3}
    - {fileID: 2800000, guid: 4f6f429e44fd00e4cb9de5f46af1d2e6, type: 3}
    intro:
      coverTagline: "El da\xF1o comienza en la punta y avanza hacia la base en bandas."
      coverImage: {fileID: 0}
      coverNarrationLineId: DISEASE_INTRO_RYNCHOSPORIUM_COVER
      infoHeadline: Reconoce el escaldado del arroz
      infoBody: "Es una enfermedad f\xFAngica que seca la hoja desde el \xE1pice.
        El da\xF1o avanza hacia la base formando bandas onduladas."
      infoRows:
      - title: Causa
        detail: El hongo Rhynchosporium oryzae.
      - title: "Patr\xF3n"
        detail: El tejido se seca desde la punta hacia la base.
      - title: "Qu\xE9 observar"
        detail: "Bandas conc\xE9ntricas de color paja y marr\xF3n en la hoja."
      infoImage: {fileID: 0}
      infoNarrationLineId: DISEASE_INTRO_RYNCHOSPORIUM_INFO
      severityHeadline: "Observa hasta d\xF3nde avanz\xF3"
      severityBody: Compara las lesiones de la hoja con las referencias. El 0 representa
        una hoja sana; diagnostica las hojas enfermas.
      severityRows: []
      severityNarrationLineId: DISEASE_INTRO_RYNCHOSPORIUM_SEVERITY
