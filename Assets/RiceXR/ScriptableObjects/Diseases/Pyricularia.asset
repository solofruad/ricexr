  m_Script: {fileID: 11500000, guid: 1ee1dfeaf232a5147886f2690a22d3c0, type: 3}
  m_Name: Pyricularia
  m_EditorClassIdentifier: Assembly-CSharp::PanelDiseaseDataObject
  id: pyricularia-oryzae
  data:
    title: "A\xF1ublo del arroz"
    scientificName: Pyricularia oryzae
    category: "Enfermedad F\xFAngica"
    description: "Se manifiesta visualmente como manchas necr\xF3ticas en forma de
      \"ojo\" o diamante, con centros de color gris ceniza y bordes marrones bien
      definidos. Su peligro real aparece cuando infecta el \"cuello\" de la espiga,
      volvi\xE9ndolo marr\xF3n y quebradizo, lo que impide el llenado del grano y
      hace que la espiga se doble o se desprenda."
    severityEvolutionImage: {fileID: 0}
    images:
    - {fileID: 2800000, guid: 9eb29fab2d4560443a8121c624f33552, type: 3}
    - {fileID: 2800000, guid: 644d790b01ad40c43ae155c47b8dcfa4, type: 3}
    - {fileID: 2800000, guid: 46e954fd2c96c2e4eb72fa5ba8b36719, type: 3}
    - {fileID: 2800000, guid: a664a83dd1fda6b43b77e2e21b530ca6, type: 3}
    intro:
      coverTagline: Manchas en forma de ojo que pueden avanzar hasta el cuello de
        la espiga.
      coverImage: {fileID: 0}
      coverNarrationLineId: DISEASE_INTRO_PYRICULARIA_COVER
      infoHeadline: "Reconoce el a\xF1ublo del arroz"
      infoBody: Es una enfermedad causada por el hongo Pyricularia oryzae. Las lesiones
        aparecen en las hojas y, si avanzan al cuello, pueden impedir el llenado
        del grano.
      infoRows:
      - title: Causa
        detail: El hongo Pyricularia oryzae.
      - title: "Propagaci\xF3n"
        detail: "Las esporas viajan con el viento, la lluvia y el roc\xEDo."
      - title: "Qu\xE9 observar"
        detail: "Manchas alargadas o en diamante, con centro gris y borde marr\xF3n."
      infoImage: {fileID: 0}
      infoNarrationLineId: DISEASE_INTRO_PYRICULARIA_INFO
      severityHeadline: "Mide cu\xE1nto da\xF1o hay"
      severityBody: Compara las lesiones de la hoja con las referencias. El 0 representa
        una hoja sana; diagnostica las hojas enfermas.
      severityRows: []
      severityNarrationLineId: DISEASE_INTRO_PYRICULARIA_SEVERITY
