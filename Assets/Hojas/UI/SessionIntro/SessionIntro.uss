/* ============================================================
   SessionIntro.uss
   Estilos compartidos por los paneles de la introducción.

   Los demás paneles del juego llevan el estilo escrito a mano en
   cada UXML. Aquí se centraliza para que los cuatro paneles de la
   intro compartan de verdad la misma paleta y se retoquen desde
   un único sitio.

   La paleta es la misma de los paneles existentes (MsgTutorialStart,
   MsgNextLevel) para que la intro no desentone con el resto.
   ============================================================ */

/* ---------- Variables ---------- */
:root {
    --c-panel-bg: rgba(10, 14, 22, 0.98);
    --c-panel-border: rgba(113, 181, 255, 0.3);

    --c-accent: rgb(113, 181, 255);
    --c-accent-soft: rgba(113, 181, 255, 0.2);
    --c-accent-strong: rgba(113, 181, 255, 0.85);

    --c-surface: rgba(255, 255, 255, 0.04);
    --c-surface-border: rgba(255, 255, 255, 0.09);
    --c-divider: rgba(255, 255, 255, 0.08);

    --c-text-primary: rgba(255, 255, 255, 0.98);
    --c-text-secondary: rgba(214, 232, 255, 0.72);
    --c-text-muted: rgba(255, 255, 255, 0.66);
}

/* ---------- Panel base ---------- */
.intro-panel {
    background-color: var(--c-panel-bg);
    border-radius: 22px;
    border-width: 1px;
    border-color: var(--c-panel-border);
    padding: 28px 32px 24px 32px;
    align-items: center;
}

.intro-panel--narrow { width: 560px; }
.intro-panel--wide { width: 800px; }

/* ---------- Círculo del icono ---------- */
.intro-icon {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: var(--c-accent-soft);
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.intro-icon__glyph {
    font-size: 30px;
    color: var(--c-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ---------- Textos ---------- */
.intro-title {
    font-size: 30px;
    color: var(--c-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.intro-subtitle {
    font-size: 15px;
    color: var(--c-text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 460px;
    margin-bottom: 4px;
}

/* Barra decorativa que cierra el panel. */
.intro-rule {
    width: 48px;
    height: 3px;
    background-color: var(--c-accent-strong);
    border-radius: 2px;
    margin-top: 18px;
}

/* ---------- Lista de viñetas (panel "qué vas a encontrar") ---------- */
.intro-list {
    width: 480px;
    margin-top: 6px;
}

.intro-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--c-surface);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--c-surface-border);
    padding: 10px 14px;
    margin-bottom: 8px;
}

.intro-row__bullet {
    font-size: 10px;
    color: var(--c-accent);
    margin-right: 12px;
}

.intro-row__text {
    font-size: 14px;
    color: var(--c-text-muted);
    white-space: normal;
    flex-grow: 1;
}

/* ---------- Tarjetas de los tres pasos ---------- */
.intro-steps-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

.intro-step {
    width: 224px;
    background-color: var(--c-surface);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--c-surface-border);
    padding: 16px 14px 18px 14px;
    margin-left: 6px;
    margin-right: 6px;
    align-items: center;
}

.intro-step__number {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: var(--c-accent-soft);
    color: var(--c-accent);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.intro-step__title {
    font-size: 17px;
    color: var(--c-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.intro-step__detail {
    font-size: 13px;
    color: var(--c-text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Botón "estoy listo" ---------- */
.intro-ready-button {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(52, 87, 132);
    border-width: 10px;
    border-color: rgb(90, 119, 125);
    border-radius: 50px;
}

.intro-ready-button__icon {
    -unity-background-scale-mode: scale-to-fit;
    width: 191px;
    height: 246px;
    margin-right: 20px;
}

.intro-ready-button__label {
    font-size: 35px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    padding-top: 15px;
}
