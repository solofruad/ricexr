<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Hojas/UI/SessionIntro/SessionIntro.uss"/>
    <ui:VisualElement name="intro-content" class="panel">
        <ui:Label text="Qué vas a encontrar" class="title"/>

        <ui:VisualElement class="list">
            <ui:VisualElement class="list__row list__row--first">
                <ui:Label text="Hojas de arroz reales, sobre tu propia mesa." class="list__text"/>
            </ui:VisualElement>

            <ui:VisualElement class="list__row">
                <ui:Label text="Manchas y lesiones que tendrás que aprender a leer." class="list__text"/>
            </ui:VisualElement>

            <ui:VisualElement class="list__row">
                <ui:Label text="Una ficha de cada enfermedad, con fotos de verdad." class="list__text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
