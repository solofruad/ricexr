<ui:UXML xmlns:ui="UnityEngine.UIElements">

    <!-- ═══════════════════════════════════════════════════════════
         PlantDiseasePanel.uxml  —  Estilo Meta Horizon OS
         Formato landscape: 860 x 420 px
         Panel de solo lectura — no requiere XRI
         ═══════════════════════════════════════════════════════════ -->

    <ui:VisualElement name="panel-root" style="
        width: 860px;
        height: 420px;
        background-color: rgba(12, 12, 16, 0.97);
        border-radius: 22px;
        flex-direction: row;
        overflow: hidden;
    ">
        <!-- ══════════════════════════════════════
             LADO IZQUIERDO — Carrusel
             carousel-image: asignar backgroundImage desde C#
             dots: activar dot-N con width:20px y color blanco
        ══════════════════════════════════════ -->
        <ui:VisualElement name="image-side" style="
            width: 380px;
            height: 100%;
            flex-shrink: 0;
            position: relative;
        ">
            <ui:VisualElement name="carousel-image" style="
                width: 100%;
                height: 100%;
                background-color: rgba(255,255,255,0.05);
            "/>

            <!-- Degradado inferior sobre imagen -->
            <ui:VisualElement style="
                position: absolute;
                bottom: 0; left: 0;
                width: 100%;
                height: 110px;
                background-color: rgba(12, 12, 16, 0.5);
            "/>

            <!-- Degradado lateral derecho hacia contenido -->
            <ui:VisualElement style="
                position: absolute;
                top: 0; right: 0;
                width: 60px;
                height: 100%;
                background-color: rgba(12, 12, 16, 0.55);
            "/>

            <!-- Dots indicadores -->
            <ui:VisualElement name="carousel-dots" style="
                position: absolute;
                bottom: 14px;
                left: 0; right: 0;
                flex-direction: row;
                justify-content: center;
                align-items: center;
            ">
                <ui:VisualElement name="dot-0" style="width:20px; height:5px; background-color:rgba(255,255,255,0.95); border-radius:3px; margin-left:3px; margin-right:3px;"/>
                <ui:VisualElement name="dot-1" style="width:5px;  height:5px; background-color:rgba(255,255,255,0.28); border-radius:3px; margin-left:3px; margin-right:3px;"/>
                <ui:VisualElement name="dot-2" style="width:5px;  height:5px; background-color:rgba(255,255,255,0.28); border-radius:3px; margin-left:3px; margin-right:3px;"/>
                <ui:VisualElement name="dot-3" style="width:5px;  height:5px; background-color:rgba(255,255,255,0.28); border-radius:3px; margin-left:3px; margin-right:3px;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══════════════════════════════════════
             LADO DERECHO — Contenido
        ══════════════════════════════════════ -->
        <ui:VisualElement name="content-side" style="
            flex-grow: 1;
            flex-direction: column;
            padding: 26px 26px 20px 22px;
            justify-content: space-between;
        ">
            <!-- Chip + título + nombre científico -->
            <ui:VisualElement name="header-block">
                <ui:VisualElement name="category-chip" style="
                    flex-direction: row;
                    align-items: center;
                    align-self: flex-start;
                    background-color: rgba(255,255,255,0.07);
                    border-radius: 20px;
                    padding: 4px 12px;
                    margin-bottom: 10px;
                ">
                    <ui:VisualElement style="
                        width: 6px; height: 6px;
                        background-color: rgb(100, 210, 120);
                        border-radius: 3px;
                        margin-right: 7px;
                    "/>
                    <ui:Label name="category-label" text="Enfermedad Fúngica" style="
                        color: rgba(255,255,255,0.5);
                        font-size: 12px;
                    "/>
                </ui:VisualElement>

                <ui:Label name="disease-title" text="Tizón Tardío" style="
                    font-size: 27px;
                    color: rgba(255,255,255,0.97);
                    -unity-font-style: bold;
                    margin-bottom: 2px;
                    white-space: normal;
                "/>
                <ui:Label name="scientific-name" text="Phytophthora infestans" style="
                    font-size: 13px;
                    color: rgba(255,255,255,0.3);
                    -unity-font-style: italic;
                "/>
            </ui:VisualElement>

            <!-- Separador -->
            <ui:VisualElement style="height:1px; background-color:rgba(255,255,255,0.07); margin-top:10px; margin-bottom:10px;"/>

            <!-- Descripción -->
            <ui:Label name="disease-description" text="Causada por un oomycete, se propaga en condiciones de alta humedad y temperaturas frescas. Las lesiones aparecen como manchas acuosas que se tornan marrones con borde amarillento. Puede destruir un cultivo completo en pocos días sin tratamiento." style="
                font-size: 15px;
                color: rgba(255,255,255,0.62);
                white-space: normal;
                flex-grow: 1;
                overflow: hidden;
            "/>

            <!-- Barra de progreso -->
            <ui:VisualElement name="progress-section" style="margin-top: 14px;">
                <ui:VisualElement style="flex-direction:row; justify-content:space-between; margin-bottom:5px;">
                    <ui:Label name="progress-label" text="Analizando muestra..." style="font-size:12px; color:rgba(255,255,255,0.35);"/>
                    <ui:Label name="progress-percent" text="0%" style="font-size:12px; color:rgba(100,210,120,0.85);"/>
                </ui:VisualElement>
                <ui:VisualElement name="progress-track" style="
                    height: 4px;
                    background-color: rgba(255,255,255,0.08);
                    border-radius: 2px;
                    overflow: hidden;
                ">
                    <ui:VisualElement name="progress-fill" style="
                        height: 100%;
                        width: 0%;
                        background-color: rgb(85, 200, 110);
                        border-radius: 2px;
                    "/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
