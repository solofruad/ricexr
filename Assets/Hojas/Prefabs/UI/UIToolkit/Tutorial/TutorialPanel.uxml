<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Hojas/UI/Shared/RiceXRUI.uss"/>
    <ui:VisualElement name="panel-tutorial" class="quest-surface quest-surface--compact quest-tutorial-panel">
        <ui:VisualElement class="quest-tutorial-header">
            <ui:VisualElement class="quest-tutorial-header__disc">
                <ui:Label text="?" class="quest-tutorial-header__label"/>
            </ui:VisualElement>
            <ui:VisualElement class="quest-tutorial-header__heading">
                <ui:Label name="tutorial-title" text="Cómo usar la herramienta" class="quest-tutorial-header__title"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="steps-container" class="quest-tutorial-steps">
            <ui:VisualElement class="tutorial-step quest-tutorial-step quest-tutorial-step--divider">
                <ui:VisualElement class="quest-tutorial-step__content">
                    <ui:Image class="quest-tutorial-step__image" style="flex-grow: 1; max-height: 176px; background-image: url(&quot;project://database/Assets/Hojas/Prefabs/UI/UIToolkit/Images/HandHolding.png?fileID=2800000&amp;guid=be9fead753be7fc459d158eafb41a98c&amp;type=3#HandHolding&quot;); -unity-background-scale-mode: scale-and-crop; background-size: auto 243px;"/>
                    <ui:Label name="tutorial-step2-title" text="Agarra una hoja con la mano" class="quest-tutorial-step__title" style="-unity-text-align: middle-center;"/>
                    <ui:Label name="tutorial-step2-body" text="Extiende la mano y cierra el puño sobre una hoja para agarrarla y examinarla de cerca." class="quest-tutorial-step__body" style="-unity-text-align: middle-center;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="tutorial-step quest-tutorial-step quest-tutorial-step--divider">
                <ui:VisualElement class="quest-tutorial-step__content">
                    <ui:Image class="quest-tutorial-step__image" style="flex-grow: 1; max-height: 176px; background-image: url(&quot;project://database/Assets/Hojas/Prefabs/UI/UIToolkit/Images/HandHoldingEye.png?fileID=2800000&amp;guid=45c9c0d05c12d3143a7f2242a7113002&amp;type=3#HandHoldingEye&quot;); -unity-background-scale-mode: scale-and-crop; background-size: auto 243px;"/>
                    <ui:Label name="tutorial-step2-title" text="Observa los sintomas en la hoja" class="quest-tutorial-step__title" style="-unity-text-align: middle-center;"/>
                    <ui:Label name="tutorial-step2-body" text="Gira la hoja para inspeccionar las manchas, el color y el patron de la lesion." class="quest-tutorial-step__body" style="-unity-text-align: middle-center;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="tutorial-step quest-tutorial-step">
                <ui:VisualElement class="quest-tutorial-step__content">
                    <ui:Image class="quest-tutorial-step__image" style="flex-grow: 1; height: auto; max-height: 176px; background-image: url(&quot;project://database/Assets/Hojas/Prefabs/UI/UIToolkit/Images/Menu.svg?fileID=7388822144124034973&amp;guid=a372fb3b2c251f0408f4c6648d2fdea8&amp;type=3#Menu&quot;); -unity-background-scale-mode: scale-to-fit; background-repeat: no-repeat no-repeat; -unity-slice-type: sliced; -unity-slice-scale: 0; background-position-y: center; background-position-x: center;"/>
                    <ui:Label name="tutorial-step3-title" text="Usa el menu para registrar tu diagnostico" class="quest-tutorial-step__title" style="-unity-text-align: middle-center;"/>
                    <ui:Label name="tutorial-step3-body" text="Selecciona la enfermedad y severidad en el panel lateral, luego presiona Confirmar." class="quest-tutorial-step__body" style="-unity-text-align: middle-center;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="tutorial-light-panel" class="quest-tutorial-light-panel">
            <ui:Label name="tutorial-light-title" text="Practica libre" class="quest-tutorial-light-title"/>
            <ui:Label name="tutorial-light-body" text="Te falta una hoja. Diagnosticala por tu cuenta para completar el tutorial." class="quest-tutorial-light-body"/>
        </ui:VisualElement>
        <ui:VisualElement class="quest-tutorial-progress">
            <ui:VisualElement class="quest-tutorial-progress__labels">
                <ui:Label name="tutorial-progress-label" text="Leyendo instrucciones..." class="quest-progress-label"/>
                <ui:Label name="tutorial-progress-percent" text="0%" class="quest-progress-percent"/>
            </ui:VisualElement>
            <ui:VisualElement name="tutorial-progress-track" class="quest-progress-track">
                <ui:VisualElement name="tutorial-progress-fill" class="quest-progress-fill" style="width: 0%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
