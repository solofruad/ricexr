<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/Hojas/UI/Shared/RiceXRUI.uss"/>
    <ui:VisualElement name="panel-tutorial" class="quest-surface quest-surface--compact quest-tutorial-panel quest-tutorial-panel--act">
        <ui:VisualElement class="quest-tutorial-header">
            <ui:VisualElement class="quest-tutorial-header__disc">
                <ui:Label text="2" class="quest-tutorial-header__label"/>
            </ui:VisualElement>
            <ui:VisualElement class="quest-tutorial-header__heading">
                <ui:Label name="tutorial-title" text="Observa los sintomas" class="quest-tutorial-header__title"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="steps-container" class="quest-tutorial-steps">
            <ui:VisualElement class="tutorial-step quest-tutorial-step quest-tutorial-step--divider">
                <ui:VisualElement class="quest-tutorial-step__content"/>
            </ui:VisualElement>
            <ui:VisualElement class="tutorial-step quest-tutorial-step quest-tutorial-step--divider">
                <ui:VisualElement class="quest-tutorial-step__content">
                    <ui:Image class="quest-tutorial-step__image" style="flex-grow: 1; max-height: 176px; background-image: url(&quot;project://database/Assets/Hojas/Prefabs/UI/UIToolkit/Images/HandHoldingEye.png?fileID=2800000&amp;guid=45c9c0d05c12d3143a7f2242a7113002&amp;type=3#HandHoldingEye&quot;); -unity-background-scale-mode: scale-and-crop; background-size: auto 243px;"/>
                    <ui:Label name="tutorial-step2-title" text="Observa los sintomas en la hoja" class="quest-tutorial-step__title" style="font-size: 22px; -unity-text-align: middle-center;"/>
                    <ui:Label name="tutorial-step2-body" text="Gira la hoja para inspeccionar las manchas, el color y el patron de la lesion." class="quest-tutorial-step__body" style="-unity-text-align: middle-center; height: 35px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
