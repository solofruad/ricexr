<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="panel-tutorial" style="width: 370px; height: 543px; background-color: rgb(12, 12, 16); border-radius: 22px; flex-direction: column; overflow: hidden; padding: 28px 32px 24px 32px;">
        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 20px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.08); padding-bottom: 5px;">
            <ui:VisualElement style="width: 40px; height: 40px; background-color: rgba(80, 160, 255, 0.15); border-radius: 20px; align-items: center; justify-content: center; margin-right: 14px; flex-shrink: 0;">
                <ui:Label text="2" style="font-size: 20px; color: rgb(80, 160, 255); -unity-font-style: bold; -unity-text-align: middle-center; width: 36px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: column;">
                <ui:Label name="tutorial-title" text="Observa los sintomas" style="font-size: 22px; color: rgba(255, 255, 255, 0.97); -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="steps-container" style="flex-direction: row; flex-grow: 1; flex-basis: auto; flex-shrink: 1; flex-wrap: nowrap; justify-content: flex-end; align-items: stretch;">
            <ui:VisualElement class="tutorial-step" style="flex-direction: row; align-items: flex-start; margin-bottom: 0; padding-left: 3px; margin-left: 3px; padding-right: 3px; margin-right: 3px; border-right-width: 1px; border-left-width: 1px;">
                <ui:VisualElement style="flex-direction: column; flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement class="tutorial-step" style="flex-direction: row; align-items: flex-start; margin-bottom: 0; padding-left: 3px; margin-left: 3px; padding-right: 3px; margin-right: 3px; border-right-width: 1px; border-left-width: 1px;">
                <ui:VisualElement style="flex-direction: column; flex-grow: 1;">
                    <ui:Image style="flex-grow: 1; max-height: 176px; background-image: url(&quot;project://database/Assets/Hojas/Prefabs/UI/UIToolkit/Images/HandHoldingEye.png?fileID=2800000&amp;guid=45c9c0d05c12d3143a7f2242a7113002&amp;type=3#HandHoldingEye&quot;); -unity-background-scale-mode: scale-and-crop; background-size: auto 243px;"/>
                    <ui:Label name="tutorial-step2-title" text="Observa los sintomas en la hoja" style="font-size: 22px; color: rgba(255, 255, 255, 0.92); -unity-font-style: bold; margin-bottom: 2px; white-space: normal; -unity-text-align: middle-center;"/>
                    <ui:Label name="tutorial-step2-body" text="Gira la hoja para inspeccionar las manchas, el color y el patron de la lesion." style="font-size: 12px; color: rgba(255, 255, 255, 0.52); white-space: normal; -unity-text-align: middle-center; height: 35px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
