<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="tutorial-demo-root" style="
        width: 560px;
        flex-direction: column;
        align-items: stretch;
    ">
        <ui:VisualElement name="tutorial-demo-diagnosis" style="
            display: none;
            background-color: rgba(12, 16, 22, 0.97);
            border-width: 2px;
            border-color: rgba(113, 181, 255, 0.35);
            border-radius: 16px;
            padding: 18px;
        ">
            <ui:Label text="Ejemplo de diagnóstico" style="
                font-size: 25px;
                color: rgba(255, 255, 255, 0.98);
                -unity-font-style: bold;
                -unity-text-align: middle-center;
                margin-bottom: 14px;
            "/>
            <ui:VisualElement name="demo-disease-option" style="
                border-width: 2px;
                border-color: rgba(255, 255, 255, 0.14);
                border-radius: 10px;
                background-color: rgba(255, 255, 255, 0.04);
                padding: 12px;
                margin-bottom: 8px;
            ">
                <ui:Label text="Enfermedad: Pyricularia oryzae" style="
                    font-size: 18px;
                    color: rgba(255, 255, 255, 0.94);
                    -unity-text-align: middle-center;
                "/>
            </ui:VisualElement>
            <ui:VisualElement name="demo-severity-option" style="
                border-width: 2px;
                border-color: rgba(255, 255, 255, 0.14);
                border-radius: 10px;
                background-color: rgba(255, 255, 255, 0.04);
                padding: 12px;
                margin-bottom: 8px;
            ">
                <ui:Label text="Severidad estimada: 3 de 5" style="
                    font-size: 18px;
                    color: rgba(255, 255, 255, 0.94);
                    -unity-text-align: middle-center;
                "/>
            </ui:VisualElement>
            <ui:VisualElement name="demo-confirm-button" style="
                border-width: 2px;
                border-color: rgba(255, 255, 255, 0.14);
                border-radius: 10px;
                background-color: rgb(52, 87, 132);
                padding: 12px;
            ">
                <ui:Label text="Confirmar diagnóstico" style="
                    font-size: 19px;
                    color: white;
                    -unity-font-style: bold;
                    -unity-text-align: middle-center;
                "/>
            </ui:VisualElement>
            <ui:VisualElement name="demo-success" style="
                display: none;
                margin-top: 12px;
                background-color: rgba(30, 130, 75, 0.35);
                border-radius: 10px;
                padding: 10px;
            ">
                <ui:Label text="Diagnóstico registrado" style="
                    font-size: 17px;
                    color: rgb(119, 255, 113);
                    -unity-font-style: bold;
                    -unity-text-align: middle-center;
                "/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="tutorial-demo-skip" style="
            margin-top: 14px;
            align-self: center;
            width: 210px;
            height: 64px;
            justify-content: center;
            background-color: rgba(20, 23, 31, 0.96);
            border-width: 2px;
            border-color: rgba(255, 255, 255, 0.28);
            border-radius: 12px;
        ">
            <ui:Label text="Omitir demostración" style="
                font-size: 18px;
                color: rgba(255, 255, 255, 0.96);
                -unity-font-style: bold;
                -unity-text-align: middle-center;
            "/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
