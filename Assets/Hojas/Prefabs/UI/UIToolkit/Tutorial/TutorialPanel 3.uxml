<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/Hojas/UI/Shared/RiceXRUI.uss"/>
    <ui:VisualElement name="panel-tutorial" class="quest-surface quest-surface--compact quest-tutorial-panel quest-tutorial-panel--act">
        <ui:VisualElement class="quest-tutorial-header">
            <ui:VisualElement class="quest-tutorial-header__disc">
                <ui:Label text="3" class="quest-tutorial-header__label"/>
            </ui:VisualElement>
            <ui:VisualElement class="quest-tutorial-header__heading">
                <ui:Label name="tutorial-title" text="Registra tu diagnóstico" class="quest-tutorial-header__title"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="steps-container" class="quest-tutorial-steps">
            <ui:VisualElement class="tutorial-step quest-tutorial-step">
                <ui:VisualElement class="quest-tutorial-step__content">
                    <ui:Image class="quest-tutorial-step__image" style="flex-grow: 1; height: auto; max-height: 176px; background-image: url(&quot;project://database/Assets/Hojas/Prefabs/UI/UIToolkit/Images/Menu.svg?fileID=7388822144124034973&amp;guid=a372fb3b2c251f0408f4c6648d2fdea8&amp;type=3#Menu&quot;); -unity-background-scale-mode: scale-to-fit; background-repeat: no-repeat no-repeat; -unity-slice-type: sliced; -unity-slice-scale: 0; background-position-y: center; background-position-x: center;"/>
                    <ui:Label name="tutorial-act-title" text="Usa el menu para registrar tu diagnostico" class="quest-tutorial-step__title" style="font-size: 19px; -unity-text-align: middle-center;"/>
                    <ui:Label name="tutorial-act-detail" text="Selecciona la enfermedad y severidad en el panel lateral, luego presiona Confirmar." class="quest-tutorial-step__body" style="-unity-text-align: middle-center; height: 41px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
