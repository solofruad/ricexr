<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="tutorial-act-1" style="
        flex-grow: 1;
        flex-direction: column;
        background-color: rgba(255, 255, 255, 0.03);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.12);
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        border-bottom-left-radius: 16px;
        border-bottom-right-radius: 16px;
        padding: 14px;
    ">
        <ui:VisualElement style="
            width: 100%;
            height: 214px;
            min-height: 214px;
            background-image: url(&quot;project://database/Assets/Hojas/Prefabs/UI/UIToolkit/Imagenes/HandHolding.png?fileID=2800000&amp;guid=be9fead753be7fc459d158eafb41a98c&amp;type=3#HandHolding&quot;);
            -unity-background-scale-mode: scale-and-crop;
            background-size: 118% auto;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
            margin-bottom: 10px;
        "/>
        <ui:Label text="Agarra una hoja con la mano" style="
            font-size: 19px;
            color: rgba(255, 255, 255, 0.96);
            -unity-font-style: bold;
            -unity-text-align: middle-center;
            margin-bottom: 4px;
        "/>
        <ui:Label text="Extiende la mano y cierra el puno sobre una hoja para iniciar la inspeccion." style="
            font-size: 13px;
            color: rgba(255, 255, 255, 0.66);
            white-space: normal;
            -unity-text-align: middle-center;
        "/>
    </ui:VisualElement>
</ui:UXML>
