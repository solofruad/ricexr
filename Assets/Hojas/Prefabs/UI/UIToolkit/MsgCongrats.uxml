<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="msg-congrats" style="
        width: 460px;
        background-color: rgba(12, 12, 16, 0.97);
        border-radius: 22px;
        padding: 36px 32px 32px 32px;
        align-items: center;
        border-width: 1px;
        border-color: rgba(255, 200, 80, 0.2);
    ">
        <ui:Label text="🏆" style="font-size: 52px; margin-bottom: 12px;"/>

        <ui:Label name="congrats-title" text="¡Excelente trabajo!" style="
            font-size: 26px;
            color: rgba(255,255,255,0.97);
            -unity-font-style: bold;
            -unity-text-align: middle-center;
            margin-bottom: 8px;
        "/>
        <ui:Label name="congrats-subtitle" text="Identificaste correctamente todas las plantas enfermas." style="
            font-size: 15px;
            color: rgba(255,255,255,0.52);
            -unity-text-align: middle-center;
            white-space: normal;
        "/>

        <ui:VisualElement style="
            width: 48px; height: 3px;
            background-color: rgba(255, 200, 80, 0.7);
            border-radius: 2px;
            margin-top: 20px;
        "/>
    </ui:VisualElement>
</ui:UXML>
