<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Hojas/UI/Shared/RiceXRUI.uss"/>
    <ui:VisualElement name="msg-final-level" class="quest-surface quest-surface--compact quest-panel quest-panel--centered quest-message quest-message--wide">
        <ui:Label text="⚠" class="quest-message__icon quest-accent--error"/>
        <ui:Label name="final-title" text="Último nivel" class="quest-message__title quest-message__title--large"/>
        <ui:Label name="final-subtitle" text="Sin ayudas" class="quest-message__subtitle quest-accent--error" style="-unity-font-style: bold; margin-bottom: 12px;"/>
        <ui:Label name="final-description" text="Ahora identificarás enfermedades por tu cuenta. Aplica todo lo que aprendiste." class="quest-message__subtitle"/>
        <ui:VisualElement class="quest-message__rule quest-message__rule--error"/>
    </ui:VisualElement>
</ui:UXML>
