/* ============================================================
   DiseaseMarker.uss — marcador de enfermedad sobre la hoja.

   La superficie sigue el mismo tratamiento que el resto de paneles.
   Rojo y azul quedan reservados para distinguir enfermedad y severidad.
   ============================================================ */

:root {
    --marker-disease: rgb(239, 111, 119);
    --marker-disease-soft: rgba(239, 111, 119, 0.14);
    --marker-disease-mid: rgba(239, 111, 119, 0.48);
    --marker-severity: rgb(118, 158, 255);
    --marker-severity-soft: rgba(118, 158, 255, 0.16);
    --marker-severity-mid: rgba(118, 158, 255, 0.48);
}

.root {
    width: 320px;
    background-color: var(--quest-surface);
    background-image: url("project://database/Assets/Hojas/UI/Shared/PanelSheen.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-radius: 24px;
    overflow: hidden;
    border-top-width: 1px;
    border-top-color: var(--quest-hairline);
}

.section-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 8px 16px;
}

.disease-header {
    background-color: var(--marker-disease-soft);
    border-bottom-width: 1px;
    border-bottom-color: var(--marker-disease-mid);
}

.severity-header {
    background-color: var(--marker-severity-soft);
    border-bottom-width: 1px;
    border-bottom-color: var(--marker-severity-mid);
}

.header-label {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--quest-text-secondary);
    -unity-font-style: bold;
}

.section-body {
    padding: 12px 16px 14px 16px;
}

.disease-name {
    font-size: 20px;
    color: var(--marker-disease);
    white-space: normal;
    -unity-font-style: bold;
}

.divider {
    height: 14px;
    background-color: transparent;
}

.severity-body {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px 16px 16px;
}

.severity-number {
    font-size: 36px;
    color: var(--marker-severity);
    -unity-font-style: bold;
    width: 48px;
    margin-right: 14px;
    -unity-text-align: middle-center;
}

.severity-bar {
    flex-direction: row;
    flex-grow: 1;
    height: 14px;
    align-items: center;
}

.seg {
    flex-grow: 1;
    height: 10px;
    border-radius: 5px;
    margin-right: 5px;
}

.seg.active {
    background-color: var(--marker-severity);
}

.seg.inactive {
    background-color: var(--marker-severity-soft);
    border-width: 1px;
    border-color: var(--marker-severity-mid);
}
