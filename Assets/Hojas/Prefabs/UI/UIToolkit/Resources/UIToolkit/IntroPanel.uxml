<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="panel-intro" style="
        width: 700px;
        background-color: rgba(12, 12, 16, 0.97);
        border-radius: 22px;
        padding: 28px 32px 24px 32px;
        border-width: 1px;
        border-color: rgba(80, 160, 255, 0.16);
        flex-direction: column;
    ">
        <ui:VisualElement style="
            flex-direction: row;
            align-items: center;
            margin-bottom: 16px;
            border-bottom-width: 1px;
            border-bottom-color: rgba(255, 255, 255, 0.08);
            padding-bottom: 10px;
        ">
            <ui:VisualElement style="
                width: 42px;
                height: 42px;
                background-color: rgba(80, 160, 255, 0.15);
                border-radius: 21px;
                align-items: center;
                justify-content: center;
                margin-right: 12px;
            ">
                <ui:Label text="i" style="
                    font-size: 20px;
                    color: rgb(80, 160, 255);
                    -unity-font-style: bold;
                    -unity-text-align: middle-center;
                    width: 36px;
                "/>
            </ui:VisualElement>

            <ui:Label name="intro-title" text="Bienvenido" style="
                font-size: 22px;
                color: rgba(255, 255, 255, 0.97);
                -unity-font-style: bold;
            "/>
        </ui:VisualElement>

        <ui:Label name="intro-body" text="" style="
            font-size: 14px;
            color: rgba(255, 255, 255, 0.70);
            white-space: normal;
            line-height: 20px;
            margin-bottom: 18px;
        "/>

        <ui:VisualElement style="
            height: 1px;
            background-color: rgba(255, 255, 255, 0.07);
            margin-bottom: 16px;
        "/>

        <ui:Button name="intro-continue-button" text="Continuar" style="
            width: 190px;
            height: 42px;
            align-self: center;
            background-color: rgba(80, 160, 255, 0.18);
            border-top-color: rgba(80, 160, 255, 0.65);
            border-right-color: rgba(80, 160, 255, 0.65);
            border-bottom-color: rgba(80, 160, 255, 0.65);
            border-left-color: rgba(80, 160, 255, 0.65);
            border-top-width: 1px;
            border-right-width: 1px;
            border-bottom-width: 1px;
            border-left-width: 1px;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
            color: rgba(255, 255, 255, 0.97);
            font-size: 15px;
            -unity-font-style: bold;
            -unity-text-align: middle-center;
        "/>
    </ui:VisualElement>
</ui:UXML>
