<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="msg-tutorial-start" style="
        width: 460px;
        background-color: rgba(12, 12, 16, 0.97);
        border-radius: 22px;
        padding: 34px 32px 30px 32px;
        align-items: center;
        border-width: 1px;
        border-color: rgba(80, 160, 255, 0.22);
    ">
        <ui:Label text="^" style="font-size: 44px; margin-bottom: 10px;"/>

        <ui:Label name="tutorialstart-title" text="Inicia el Nivel 1: Tutorial" style="
            font-size: 26px;
            color: rgba(255, 255, 255, 0.97);
            -unity-font-style: bold;
            -unity-text-align: middle-center;
            margin-bottom: 8px;
        "/>

        <ui:Label name="tutorialstart-sub" text="Primero aprenderas a usar la herramienta VR." style="
            font-size: 15px;
            color: rgba(255, 255, 255, 0.48);
            -unity-text-align: middle-center;
            white-space: normal;
        "/>

        <ui:VisualElement style="
            width: 48px;
            height: 3px;
            background-color: rgba(80, 160, 255, 0.7);
            border-radius: 2px;
            margin-top: 22px;
        "/>
    </ui:VisualElement>
</ui:UXML>
