<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!--
        MsgProgress.uxml
        IMPORTANTE: el VisualElement name="progress-dots" es requerido por UIMessagesController.
        Los dots reales se generan dinámicamente en runtime según plantsRequired del nivel.
        Este contenedor solo actúa como padre — no pongas dots hardcodeados aquí.
    -->
    <ui:VisualElement name="msg-progress" style="
        width: 460px;
        background-color: rgba(12, 12, 16, 0.97);
        border-radius: 22px;
        padding: 30px 32px 28px 32px;
        align-items: center;
    ">
        <ui:Label text="🌿" style="font-size: 44px; margin-bottom: 10px;"/>

        <ui:Label name="progress-main" text="0 de 1 plantas" style="
            font-size: 26px;
            color: rgba(255,255,255,0.97);
            -unity-font-style: bold;
            -unity-text-align: middle-center;
            margin-bottom: 6px;
        "/>

        <ui:Label name="progress-sub" text="Te falta 1 planta por seleccionar." style="
            font-size: 15px;
            color: rgba(255,255,255,0.48);
            -unity-text-align: middle-center;
            white-space: normal;
            margin-bottom: 20px;
        "/>

        <!--
            progress-dots: contenedor de dots generados dinámicamente por UIMessagesController.
            EnsureProgressDots() añade aquí los VisualElements de cada planta.
        -->
        <ui:VisualElement name="progress-dots" style="
            flex-direction: row;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
        "/>

    </ui:VisualElement>
</ui:UXML>
