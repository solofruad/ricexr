<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="root" style="
        width: 600px;
        height: 800px;
        background-color: rgba(10, 10, 20, 0.95);
        border-radius: 16px;
        padding: 24px;
        flex-direction: column;
        align-items: stretch;
    ">
        <!-- Header -->
        <ui:VisualElement name="header" style="
            flex-direction: row;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            border-bottom-width: 2px;
            border-bottom-color: rgba(255, 200, 50, 0.6);
            padding-bottom: 12px;
        ">
            <ui:Label name="title" text="🏆 LEADERBOARD" style="
                font-size: 28px;
                color: rgb(255, 200, 50);
                -unity-font-style: bold;
                -unity-text-align: middle-center;
            "/>
        </ui:VisualElement>

        <!-- Column headers -->
        <ui:VisualElement name="column-headers" style="
            flex-direction: row;
            padding: 8px 12px;
            margin-bottom: 4px;
        ">
            <ui:Label text="#" style="width: 48px; color: rgba(255,255,255,0.5); font-size: 14px; -unity-font-style: bold;"/>
            <ui:Label text="PLAYER" style="flex-grow: 1; color: rgba(255,255,255,0.5); font-size: 14px; -unity-font-style: bold;"/>
            <ui:Label text="SCORE" style="width: 100px; color: rgba(255,255,255,0.5); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-right;"/>
        </ui:VisualElement>

        <!-- Scrollable list -->
        <ui:ScrollView name="leaderboard-scroll" style="flex-grow: 1;">

            <!-- Entry 1 - Gold -->
            <ui:VisualElement name="entry-1" class="entry entry-gold" style="
                flex-direction: row;
                align-items: center;
                background-color: rgba(255, 200, 50, 0.15);
                border-radius: 8px;
                padding: 12px;
                margin-bottom: 6px;
                border-left-width: 3px;
                border-left-color: rgb(255, 200, 50);
            ">
                <ui:Label text="1" style="width: 48px; font-size: 18px; color: rgb(255, 200, 50); -unity-font-style: bold;"/>
                <ui:Label text="PlayerOne" style="flex-grow: 1; font-size: 18px; color: rgb(255, 255, 255); -unity-font-style: bold;"/>
                <ui:Label text="98,450" style="width: 100px; font-size: 18px; color: rgb(255, 200, 50); -unity-font-style: bold; -unity-text-align: middle-right;"/>
            </ui:VisualElement>

            <!-- Entry 2 - Silver -->
            <ui:VisualElement name="entry-2" class="entry entry-silver" style="
                flex-direction: row;
                align-items: center;
                background-color: rgba(180, 180, 200, 0.1);
                border-radius: 8px;
                padding: 12px;
                margin-bottom: 6px;
                border-left-width: 3px;
                border-left-color: rgb(180, 180, 200);
            ">
                <ui:Label text="2" style="width: 48px; font-size: 18px; color: rgb(180, 180, 200); -unity-font-style: bold;"/>
                <ui:Label text="VRMaster99" style="flex-grow: 1; font-size: 18px; color: rgb(220, 220, 220);"/>
                <ui:Label text="87,200" style="width: 100px; font-size: 18px; color: rgb(180, 180, 200); -unity-text-align: middle-right;"/>
            </ui:VisualElement>

            <!-- Entry 3 - Bronze -->
            <ui:VisualElement name="entry-3" class="entry entry-bronze" style="
                flex-direction: row;
                align-items: center;
                background-color: rgba(200, 120, 50, 0.1);
                border-radius: 8px;
                padding: 12px;
                margin-bottom: 6px;
                border-left-width: 3px;
                border-left-color: rgb(200, 120, 50);
            ">
                <ui:Label text="3" style="width: 48px; font-size: 18px; color: rgb(200, 120, 50); -unity-font-style: bold;"/>
                <ui:Label text="QuestPro_X" style="flex-grow: 1; font-size: 18px; color: rgb(220, 220, 220);"/>
                <ui:Label text="76,800" style="width: 100px; font-size: 18px; color: rgb(200, 120, 50); -unity-text-align: middle-right;"/>
            </ui:VisualElement>

            <!-- Entries 4-10 - Normal -->
            <ui:VisualElement name="entry-4" class="entry" style="flex-direction: row; align-items: center; background-color: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; margin-bottom: 6px;">
                <ui:Label text="4" style="width: 48px; font-size: 16px; color: rgba(255,255,255,0.6);"/>
                <ui:Label text="ShadowRunner" style="flex-grow: 1; font-size: 16px; color: rgb(200, 200, 200);"/>
                <ui:Label text="65,100" style="width: 100px; font-size: 16px; color: rgba(255,255,255,0.8); -unity-text-align: middle-right;"/>
            </ui:VisualElement>

            <ui:VisualElement name="entry-5" class="entry" style="flex-direction: row; align-items: center; background-color: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; margin-bottom: 6px;">
                <ui:Label text="5" style="width: 48px; font-size: 16px; color: rgba(255,255,255,0.6);"/>
                <ui:Label text="NeonHawk" style="flex-grow: 1; font-size: 16px; color: rgb(200, 200, 200);"/>
                <ui:Label text="58,900" style="width: 100px; font-size: 16px; color: rgba(255,255,255,0.8); -unity-text-align: middle-right;"/>
            </ui:VisualElement>

            <ui:VisualElement name="entry-6" class="entry" style="flex-direction: row; align-items: center; background-color: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; margin-bottom: 6px;">
                <ui:Label text="6" style="width: 48px; font-size: 16px; color: rgba(255,255,255,0.6);"/>
                <ui:Label text="CyberFox42" style="flex-grow: 1; font-size: 16px; color: rgb(200, 200, 200);"/>
                <ui:Label text="47,350" style="width: 100px; font-size: 16px; color: rgba(255,255,255,0.8); -unity-text-align: middle-right;"/>
            </ui:VisualElement>

            <ui:VisualElement name="entry-7" class="entry" style="flex-direction: row; align-items: center; background-color: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; margin-bottom: 6px;">
                <ui:Label text="7" style="width: 48px; font-size: 16px; color: rgba(255,255,255,0.6);"/>
                <ui:Label text="VoidWalker" style="flex-grow: 1; font-size: 16px; color: rgb(200, 200, 200);"/>
                <ui:Label text="39,700" style="width: 100px; font-size: 16px; color: rgba(255,255,255,0.8); -unity-text-align: middle-right;"/>
            </ui:VisualElement>

            <ui:VisualElement name="entry-8" class="entry" style="flex-direction: row; align-items: center; background-color: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; margin-bottom: 6px;">
                <ui:Label text="8" style="width: 48px; font-size: 16px; color: rgba(255,255,255,0.6);"/>
                <ui:Label text="GhostPixel" style="flex-grow: 1; font-size: 16px; color: rgb(200, 200, 200);"/>
                <ui:Label text="31,200" style="width: 100px; font-size: 16px; color: rgba(255,255,255,0.8); -unity-text-align: middle-right;"/>
            </ui:VisualElement>

            <ui:VisualElement name="entry-9" class="entry" style="flex-direction: row; align-items: center; background-color: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; margin-bottom: 6px;">
                <ui:Label text="9" style="width: 48px; font-size: 16px; color: rgba(255,255,255,0.6);"/>
                <ui:Label text="PixelStorm" style="flex-grow: 1; font-size: 16px; color: rgb(200, 200, 200);"/>
                <ui:Label text="24,800" style="width: 100px; font-size: 16px; color: rgba(255,255,255,0.8); -unity-text-align: middle-right;"/>
            </ui:VisualElement>

            <ui:VisualElement name="entry-10" class="entry" style="flex-direction: row; align-items: center; background-color: rgba(255,255,255,0.05); border-radius: 8px; padding: 12px; margin-bottom: 6px;">
                <ui:Label text="10" style="width: 48px; font-size: 16px; color: rgba(255,255,255,0.6);"/>
                <ui:Label text="ArcLight" style="flex-grow: 1; font-size: 16px; color: rgb(200, 200, 200);"/>
                <ui:Label text="18,500" style="width: 100px; font-size: 16px; color: rgba(255,255,255,0.8); -unity-text-align: middle-right;"/>
            </ui:VisualElement>

        </ui:ScrollView>

        <!-- Footer: player local score -->
        <ui:VisualElement name="footer" style="
            margin-top: 12px;
            padding-top: 12px;
            border-top-width: 1px;
            border-top-color: rgba(255,255,255,0.2);
            flex-direction: row;
            align-items: center;
            background-color: rgba(100, 180, 255, 0.1);
            border-radius: 8px;
            padding: 12px;
        ">
            <ui:Label text="YOU" style="width: 48px; font-size: 14px; color: rgb(100, 180, 255); -unity-font-style: bold;"/>
            <ui:Label name="local-player-name" text="YourName" style="flex-grow: 1; font-size: 16px; color: rgb(100, 180, 255); -unity-font-style: bold;"/>
            <ui:Label name="local-player-score" text="12,300" style="width: 100px; font-size: 16px; color: rgb(100, 180, 255); -unity-font-style: bold; -unity-text-align: middle-right;"/>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
