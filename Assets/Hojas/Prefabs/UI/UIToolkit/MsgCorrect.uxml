<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Hojas/UI/Shared/RiceXRUI.uss"/>
    <ui:VisualElement name="msg-correct" class="quest-surface quest-feedback" style="position: relative; bottom: 120px;">
        <ui:VisualElement class="quest-feedback__header">
            <ui:Label text="✓" name="Label" class="quest-feedback__icon quest-feedback__icon--success quest-feedback__icon-label quest-feedback__icon-label--success"/>
            <ui:Label name="incorrect-title" text="¡Correcto!" class="quest-feedback__title quest-feedback__title--success"/>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" class="quest-feedback__message">
            <ui:Label name="incorrect-sub" text="La enfermedad y severidad seleccionada son correctas." class="quest-feedback__body" style="-unity-text-align: middle-center;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
