%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00768d61fb33b2b4a8dbdad8a7ab1efe, type: 3}
  m_Name: NarrationLineLibrary
  m_EditorClassIdentifier: Assembly-CSharp::NarrationLineLibrary
  lines:
  - id: START_SELECT_PLANE
    text: Bienvenido a la experiencia de diagnostico de enfermedades en arroz. Acercate
      a un plano azul y seleccionalo para comenzar.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: ONBOARDING_OVERVIEW
    text: 'Recorreras cuatro niveles: tutorial, Pyricularia, Rhynchosporium y evaluacion
      final sin ayudas visuales.'
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: ONBOARDING_CONTINUE
    text: Cuando estes listo, pulsa Continuar para iniciar la practica guiada.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: TUTORIAL_BEGIN
    text: Inicia el tutorial. Te guiaremos en cada paso del diagnostico.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: TUTORIAL_GRAB
    text: Paso uno. Agarra una hoja con tu mano para poder inspeccionarla de cerca.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: TUTORIAL_INSPECT
    text: 'Paso dos. Observa la lesion: forma, borde, centro y distribucion sobre
      la hoja.'
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: TUTORIAL_MENU_OPEN
    text: Paso tres. Abre el menu lateral de diagnostico.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: TUTORIAL_SELECT_DISEASE
    text: Selecciona la enfermedad que mejor coincide con los sintomas observados.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: TUTORIAL_SELECT_SEVERITY
    text: Ahora selecciona la severidad segun el dano visible en la hoja.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: TUTORIAL_CONFIRM
    text: Presiona Confirmar para registrar tu diagnostico.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: TUTORIAL_DONE
    text: Excelente. Completaste el tutorial y estas listo para el siguiente nivel.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: LEVEL2_INTRO
    text: Nivel dos de cuatro. En este nivel trabajas con Anublo del arroz.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: LEVEL2_EXPLAIN
    text: Pyricularia oryzae suele mostrar manchas necroticas en forma de ojo, con
      centro gris y borde marron definido.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: LEVEL3_INTRO
    text: Nivel tres de cuatro. Ahora trabajas con Escaldado del arroz.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: LEVEL3_EXPLAIN
    text: Rhynchosporium oryzae suele iniciar en la punta y avanzar en bandas concentricas
      hacia la base.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: FINAL_WARNING
    text: Ultimo nivel. No tendras ayudas visuales. Confia en lo aprendido y diagnostica
      por tu cuenta.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: PROGRESS_REMAIN_3
    text: Te faltan tres hojas para completar este nivel.
    enabled: 1
    cooldownSec: 0.25
    oncePerSession: 0
    oncePerLevel: 1
    firstErrorOnly: 0
  - id: PROGRESS_REMAIN_2
    text: Te faltan dos hojas para completar este nivel.
    enabled: 1
    cooldownSec: 0.25
    oncePerSession: 0
    oncePerLevel: 1
    firstErrorOnly: 0
  - id: PROGRESS_REMAIN_1
    text: Te falta una hoja para completar este nivel.
    enabled: 1
    cooldownSec: 0.25
    oncePerSession: 0
    oncePerLevel: 1
    firstErrorOnly: 0
  - id: PROGRESS_DONE
    text: Completaste las hojas requeridas de este nivel.
    enabled: 1
    cooldownSec: 0.25
    oncePerSession: 0
    oncePerLevel: 1
    firstErrorOnly: 0
  - id: FIRST_CORRECT
    text: Bien hecho. Ese diagnostico es correcto.
    enabled: 1
    cooldownSec: 0.25
    oncePerSession: 0
    oncePerLevel: 1
    firstErrorOnly: 0
  - id: SECOND_CORRECT
    text: Excelente. Vas por muy buen camino.
    enabled: 1
    cooldownSec: 0.25
    oncePerSession: 0
    oncePerLevel: 1
    firstErrorOnly: 0
  - id: THIRD_CORRECT
    text: Muy bien. Objetivo del nivel cumplido.
    enabled: 1
    cooldownSec: 0.25
    oncePerSession: 0
    oncePerLevel: 1
    firstErrorOnly: 0
  - id: FIRST_ERROR_ONLY
    text: Ese diagnostico no coincide. Revisa nuevamente la lesion y la severidad
      antes de confirmar.
    enabled: 1
    cooldownSec: 0.25
    oncePerSession: 0
    oncePerLevel: 0
    firstErrorOnly: 1
  - id: LEVEL_COMPLETE
    text: Nivel completado. Preparate para la siguiente fase.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 0
    oncePerLevel: 1
    firstErrorOnly: 0
  - id: ALL_LEVELS_COMPLETE
    text: Excelente trabajo. Has completado toda la experiencia.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: ENDSESSION_PROMPT_SAVE
    text: Ingresa tu apodo para guardar el resultado en el marcador.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: SAVE_OK
    text: Guardado exitoso. Tu resultado fue registrado correctamente.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: SAVE_FAIL
    text: No se pudo guardar el resultado. Intenta nuevamente.
    enabled: 1
    cooldownSec: 1
    oncePerSession: 0
    oncePerLevel: 0
    firstErrorOnly: 0
  - id: RETURN_MENU
    text: Sesion finalizada. Regresando al menu principal.
    enabled: 1
    cooldownSec: 0
    oncePerSession: 1
    oncePerLevel: 0
    firstErrorOnly: 0
